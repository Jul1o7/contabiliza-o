# Chave da API OpenAI (obrigatória para categorização com IA)
OPENAI_API_KEY=your_openai_api_key_here

# Chave da API ExchangeRate (opcional - para conversão de moedas)
# Obtenha gratuitamente em: https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# Moeda padrão (ex: BRL, USD, EUR)
DEFAULT_CURRENCY=BRL
